generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model bid {
  id        Int      @id @default(autoincrement())
  playerId  Int
  teamId    Int
  amount    Int
  createdAt DateTime @default(now())
  player    player   @relation(fields: [playerId], references: [id], onDelete: Cascade, map: "Bid_playerId_fkey")
  team      team     @relation(fields: [teamId], references: [id], onDelete: Cascade, map: "Bid_teamId_fkey")

  @@index([playerId], map: "Bid_playerId_fkey")
  @@index([teamId], map: "Bid_teamId_fkey")
}

model player {
  id          Int     @id @default(autoincrement())
  name        String
  teamId      Int?
  basePrice   Int
  sold        Boolean @default(false)
  currentBid  Int?
  category    String
  fromWhere   String
  phoneNumber String?
  photo       String? @db.LongText
  status      String  @default("AVAILABLE")
  queueOrder  Int     @default(0)
  bids        bid[]
  team        team?   @relation(fields: [teamId], references: [id], map: "Player_teamId_fkey")

  @@index([teamId], map: "Player_teamId_fkey")
}

model team {
  id      Int      @id @default(autoincrement())
  name    String
  purse   Int
  logo    String?  @db.LongText
  bids    bid[]
  players player[]
}

model TournamentSettings {
  id               Int      @id @default(autoincrement())
  tournamentName   String   @default("Kudal Premier League")
  tournamentLogo   String?  @db.LongText
  season           String?  @default("Season 1")
  whatsappTemplate String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

