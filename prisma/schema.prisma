generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Player {
  id        Int     @id @default(autoincrement())
  name      String
  teamId    Int?
  team      Team?   @relation(fields: [teamId], references: [id])
  basePrice Int
  sold      Boolean @default(false)
  currentBid Int? 
  category  String
  fromWhere String
}

model Team {
  id         Int      @id @default(autoincrement())
  name       String
  purse      Int
  players    Player[]
}

model Bid {
  id        Int     @id @default(autoincrement())
  playerId  Int
  teamId    Int
  amount    Int
  createdAt DateTime @default(now())
}